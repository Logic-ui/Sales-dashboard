{
  "buildCommand": "npm --prefix frontend ci && npm --prefix frontend run build",
  "outputDirectory": "frontend/build",
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py?__path__=/api/$1"
    },
    {
      "source": "/api",
      "destination": "/api/index.py?__path__=/api"
    },
    {
      "source": "/auth/(.*)",
      "destination": "/api/index.py?__path__=/api/auth/$1"
    },
    {
      "source": "/ping",
      "destination": "/api/index.py?__path__=/api/ping"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py?__path__=/docs"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py?__path__=/openapi.json"
    },
    {
      "source": "/((?!api/|static/|favicon.ico|manifest.json|images/).*)",
      "destination": "/index.html"
    }
  ]
}
