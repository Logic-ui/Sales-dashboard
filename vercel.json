{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/auth/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/dashboard/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/sales/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/products/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/pos/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/customers/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/coupons/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/users/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/ping",
      "dest": "api/index.py"
    },
    {
      "src": "/docs",
      "dest": "api/index.py"
    },
    {
      "src": "/openapi.json",
      "dest": "api/index.py"
    },
    {
      "src": "/static/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "frontend/build/static/$1"
    },
    {
      "src": "/favicon.ico",
      "dest": "frontend/build/favicon.ico"
    },
    {
      "src": "/manifest.json",
      "dest": "frontend/build/manifest.json"
    },
    {
      "src": "/(.*)",
      "headers": {
        "Cache-Control": "no-cache, no-store, must-revalidate"
      },
      "dest": "frontend/build/index.html"
    }
  ]
}
